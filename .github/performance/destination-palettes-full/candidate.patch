diff --git a/quality/benchmarks/src/jmh/kotlin/dev/s7a/strata/quality/benchmark/DestinationPaletteBenchmark.kt b/quality/benchmarks/src/jmh/kotlin/dev/s7a/strata/quality/benchmark/DestinationPaletteBenchmark.kt
