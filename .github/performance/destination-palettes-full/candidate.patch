diff --git a/runtime/headless/src/test/kotlin/dev/s7a/strata/runtime/headless/HeadlessDestinationPaletteTest.kt b/runtime/headless/src/test/kotlin/dev/s7a/strata/runtime/headless/HeadlessDestinationPaletteTest.kt
