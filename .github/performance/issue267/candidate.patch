+        assertSame(primary, assertFailsWith<IllegalStateException> { session.frame(Constraints.fixed(2, 2)) })
+        assertEquals(listOf(later), primary.suppressedExceptions)
+        assertEquals(1, source.releases)
+        session.close()
+    }
+
+    @Test
