+            assertEquals(
+                listOf(2, 0, 1),
+                probe.trace
+                    .filterIsInstance<DescriptionValidationProbe.Event.Ownership>()
+                    .filter { it.phase == DescriptionValidationProbe.Phase.Update && it.id != 9 }
+                    .map { it.id },
+            )
+            assertEquals(listOf(10, 11, 12), children.map { it.editing })
+        }
+    }
+
