diff --git a/runtime/core/src/commonTest/kotlin/dev/s7a/strata/runtime/PortableVirtualRowObservationTest.kt b/runtime/core/src/commonTest/kotlin/dev/s7a/strata/runtime/PortableVirtualRowObservationTest.kt
