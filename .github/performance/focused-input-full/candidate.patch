+        val nodes = List(4) { id -> ProbeNode(initial = id == 0, changed = { transitions += id to it }) }
+        val fixture = owners(nodes)
+        var firstRead = true
+        nodes[1].readAcceptance = {
+            if (firstRead) {
+                firstRead = false
+                nodes[2].accepting = true
