+                when (workload.kind) {
+                    Kind.ColdAdmission, Kind.FirstAdmission, Kind.LastCloseReuse, Kind.SparseRemoval, Kind.Replacement -> u
+                    Kind.OwnerReversal -> u * 3
+                    else -> 0L
+                }
