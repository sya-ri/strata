+                    Kind.OwnerReversal -> 6L
+                    else -> 0L
+                }
+            val evaluated =
+                when (workload.kind) {
+                    Kind.FrameUnequal, Kind.Coalesced, Kind.ComponentFrame -> {
+                        n
+                    }
+
+                    Kind.Cycles -> {
+                        n * 64
+                    }
+
+                    Kind.ColdAdmission, Kind.FirstAdmission, Kind.Replacement -> {
+                        n * 2
+                    }
+
+                    Kind.LastCloseReuse -> {
+                        n
+                    }
+
+                    Kind.SparseRemoval -> {
