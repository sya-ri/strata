+                    val face =
+                        FontTestFace(
+                            {
+                                glyphs++
+                                MinecraftFontGlyph(7f, 0f, 0f, 0f, 0f, null)
+                            },
+                            {
+                                active--
+                                closes++
+                                owner.close()
+                                if (failure != null) throw failure
+                            },
+                        )
+                    owner.close()
+                    face
+                },
+                release = { owner.close() },
+            )
+        owner = MinecraftFontEngine(snapshot, { backend }, cacheEntries = entries, maxFaces = 1)
+        val missing = owner.glyph(ResourceId("unknown", "terminal"), 'A'.code)
