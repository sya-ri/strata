+        val extra = if (disabled) """, "filter":{"uniform":true}""" else ""
+        val snapshot =
+            FontTestResources.snapshot(
+                FontTestResources.font("default", """{"type":"ttf","file":"test:face.ttf"$extra},{"type":"ttf","file":"test:unused.ttf"}"""),
