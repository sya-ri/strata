+            assertEquals(0, active)
+            assertEquals(0, glyphs)
+            assertEquals(1, closes)
+            assertEquals(1, backend.openCalls)
+            assertEquals(1, backend.closeCalls)
+            assertTrue(owner.diagnostics.isEmpty())
