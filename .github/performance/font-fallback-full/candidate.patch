+            assertEquals(missing, owner.glyph(ResourceId("minecraft", "default"), 'A'.code))
+            assertTerminal(owner)
+            assertEquals(1, opens)
+            assertEquals(0, glyphs)
+            assertEquals(1, closes)
+            assertEquals(1, backendCloses)
