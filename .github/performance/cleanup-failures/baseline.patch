diff --git a/runtime/minecraft/src/test/kotlin/dev/s7a/strata/runtime/minecraft/canvas/CanvasFailuresTest.kt b/runtime/minecraft/src/test/kotlin/dev/s7a/strata/runtime/minecraft/canvas/CanvasFailuresTest.kt
