+    val commands: Int,
+) {
+    Idle(0),
+    One(1),
+    Seven(7),
+    Eight(8),
+    SixtyThree(63),
+    ExactLimit(64),
+    LimitPlusOne(65),
+    BusyProducer(65),
+}
