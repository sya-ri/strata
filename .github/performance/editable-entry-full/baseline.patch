+                check(message is RemoteMessage.Resynchronize)
+                check(message.session == lastMessage + 1)
+                lastMessage = message.session
+                delivered++
+            }
+            val callback = afterWrite
+            afterWrite = null
+            callback?.invoke()
+        }
+    }
+}
