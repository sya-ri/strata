+                    evaluations += 1
+                    element(probe.element(1, it))
+                }
+            }
+        }.use { session ->
+            session.attach()
+            session.frame(Constraints())
+            probe.onUpdate = {
+                probe.onUpdate = null
+                source.publish(2)
+            }
+            source.publish(1)
+            session.frame(Constraints())
+            check(probe.nodes.single().payload == 1 && evaluations == 2)
+            session.frame(Constraints())
+            check(probe.nodes.single().payload == 2 && evaluations == 3)
