+                    Int.MAX_VALUE,
+                    TextStyle.Normal,
+                    logicalOrder = true,
+                )
+            val expected = listOf(intArrayOf(0, 1, 3), intArrayOf(5, 6, 7), intArrayOf(8))
+            assertEquals(3, layout.lines.size)
+            assertEquals(listOf(5, 8, 8), layout.lines.map { it.nextStart })
+            for ((line, offsets) in layout.lines.zip(expected)) {
