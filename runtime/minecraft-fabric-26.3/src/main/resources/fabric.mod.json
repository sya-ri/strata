{
  "schemaVersion": 1,
  "id": "strata",
  "version": "${version}",
  "name": "Strata",
  "description": "A declarative Minecraft UI library for Fabric clients and servers.",
  "authors": [
    "sya-ri"
  ],
  "contact": {
    "homepage": "https://gh.s7a.dev/strata/",
    "sources": "https://github.com/sya-ri/strata",
    "issues": "https://github.com/sya-ri/strata/issues"
  },
  "license": "MIT",
  "environment": "*",
  "accessWidener": "strata-sampled-gui.accesswidener",
  "entrypoints": {
    "client": [
      "dev.s7a.strata.runtime.minecraft.fabric.StrataFabricClient"
    ],
    "main": [
      "dev.s7a.strata.runtime.minecraft.fabric.StrataFabric"
    ]
  },
  "mixins": [
    "strata.client.mixins.json",
    "strata.canvas.mixins.json",
    "strata.canvas.gui.mixins.json",
    "strata.canvas.frame.mixins.json",
    "strata.canvas.vulkan.mixins.json",
    "strata.server.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabricLoader}",
    "minecraft": "${minecraft}",
    "fabric-language-kotlin": ">=${fabricLanguageKotlin}",
    "java": ">=${java}",
    "fabric-api": "${fabricApi}"
  }
}
