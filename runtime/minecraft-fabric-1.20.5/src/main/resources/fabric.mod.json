{
  "schemaVersion": 1,
  "id": "strata",
  "version": "${version}",
  "name": "Strata",
  "description": "A declarative Minecraft UI library with a separately installed Fabric client runtime.",
  "authors": [
    "sya-ri"
  ],
  "contact": {
    "homepage": "https://gh.s7a.dev/strata/",
    "sources": "https://github.com/sya-ri/strata",
    "issues": "https://github.com/sya-ri/strata/issues"
  },
  "license": "MIT",
  "environment": "client",
  "mixins": [
    "strata.client.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "dev.s7a.strata.runtime.minecraft.fabric.StrataFabricClient"
    ]
  },
  "mixins": [
    "strata.canvas.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabricLoader}",
    "minecraft": "${minecraft}",
    "fabric-language-kotlin": ">=${fabricLanguageKotlin}",
    "java": ">=${java}"
  }
}
