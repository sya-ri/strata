{
  "schemaVersion": 1,
  "id": "${integrationModId}",
  "version": "${version}",
  "name": "Strata Minecraft Fabric 1.20 Integration",
  "description": "Loaded-client integration verification for Strata on Minecraft 1.20.",
  "environment": "*",
  "accessWidener": "strata-font-parity.accesswidener",
  "mixins": [
    "strata.canvas.tests.mixins.json"
  ],
  "entrypoints": {
    "main": ["dev.s7a.strata.integration.minecraft.fabric.FabricServerUiAcceptance"],
    "client": [
      "dev.s7a.strata.integration.minecraft.fabric.RemoteNativeCanvasFixture",
      "dev.s7a.strata.integration.minecraft.fabric.PaperRemoteExtensionClient",
      "dev.s7a.strata.integration.minecraft.fabric.StrataMinecraftFontClientTest"
    ]
  },
  "depends": {
    "fabricloader": "*",
    "minecraft": "${minecraftVersion}",
    "${runtimeModId}": "${version}"
  }
}
